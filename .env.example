# Get this from https://console.groq.com -> API Keys -> Create
GROQ_API_KEY=gsk_your_key_here

# Get this from Supabase -> Settings -> Database -> Connection pooler URL
# IMPORTANT: Use the POOLER URL on port 6543, NOT direct connection on 5432
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres